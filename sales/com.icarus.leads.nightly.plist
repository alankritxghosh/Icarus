<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.icarus.leads.nightly</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/alankritghosh/JARVIS /jarvis_engineering/sales/run_nightly.sh</string>
  </array>

  <!-- 06:12, not 06:00: a missed calendar run fires shortly after the Mac
       wakes, which is the point -- the briefing is there when the lid opens. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>12</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/alankritghosh/JARVIS /jarvis_engineering</string>

  <key>StandardErrorPath</key>
  <string>/Users/alankritghosh/JARVIS /jarvis_engineering/outputs/leads/logs/launchd.err</string>
  <key>StandardOutPath</key>
  <string>/Users/alankritghosh/JARVIS /jarvis_engineering/outputs/leads/logs/launchd.out</string>
</dict>
</plist>
