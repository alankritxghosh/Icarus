# Editor / OS
.DS_Store
.claude/settings.local.json

# Secrets & local config (never commit credentials — GitHub tokens, API keys)
.env
.env.*
# The committed template carries NO real keys, so un-ignore just it:
!.env.example
*.local

# Python (cloud services)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node / macOS app builds (added as those phases begin)
node_modules/
dist/
build/

# Eval / ingest scratch data (real repos are cloned locally, not committed)
repositories/
*.sqlite
*.db

# Demo per-repo corpus cache (switched-to public repos; not committed)
evals/corpus/cache/

# Per-user corpora (public caches AND private code) — never committed
data/
