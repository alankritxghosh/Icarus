{
  "description": "Large public-repo benchmark for JARVIS Engineering Intelligence v1 documented-decision retrieval. Each repo is an explicit local checkout under the allowlisted repositories root. Questions target documented decisions, architecture rationale, and decision evolution. Change-impact and dependency-tracing questions are included only as negative cases that v1 must refuse with UNSUPPORTED_QUESTION. Evidence paths and keywords were confirmed against the committed HEAD blobs at authoring time and may drift as upstream history advances.",
  "repositories_root": "~/jarvis_test_repos",
  "repos": [
    {
      "slug": "pallets/flask",
      "github_url": "https://github.com/pallets/flask",
      "checkout": "~/jarvis_test_repos/flask",
      "questions": [
        {
          "id": "flask-explicit-app-object",
          "question": "Why does Flask require an explicit application object?",
          "type": "documented-decision",
          "expected": {
            "classification": "observed",
            "must_not_be_unknown": true,
            "likely_evidence": ["docs/design.rst"],
            "keywords": ["explicit application object", "WSGI", "package name", "import"]
          }
        },
        {
          "id": "flask-context-locals",
          "question": "What is the rationale for Flask using context locals and proxies?",
          "type": "documented-decision",
          "expected": {
            "classification": "observed",
            "must_not_be_unknown": true,
            "likely_evidence": ["docs/design.rst", "docs/reqcontext.rst", "docs/appcontext.rst"],
            "keywords": ["Context Locals", "proxies", "worker", "thread"]
          }
        },
        {
          "id": "flask-blueprints",
          "question": "Why does Flask provide blueprints to organize an application?",
          "type": "architecture-decision",
          "expected": {
            "classification": "observed",
            "must_not_be_unknown": true,
            "likely_evidence": ["docs/blueprints.rst"],
            "keywords": ["Why Blueprints", "separation", "not a pluggable app", "register"]
          }
        },
        {
          "id": "flask-jinja-choice",
          "question": "Why did Flask adopt Jinja as its template engine?",
          "type": "documented-decision",
          "expected": {
            "classification": "observed",
            "must_not_be_unknown": true,
            "likely_evidence": ["docs/templating.rst", "docs/design.rst"],
            "keywords": ["Jinja", "template engine", "autoescaping", "extension"]
          }
        },
        {
          "id": "flask-microframework",
          "question": "Why is Flask designed as a microframework?",
          "type": "architecture-decision",
          "expected": {
            "classification": "observed",
            "must_not_be_unknown": true,
            "likely_evidence": ["docs/design.rst"],
            "keywords": ["microframework", "micro", "core", "simple"]
          }
