        {
          "id": "flask-change-impact-unsupported",
          "question": "What is the impact of changing Flask's request context handling?",
          "type": "change-impact",
          "supported": false,
          "expected": {
            "error_code": "UNSUPPORTED_QUESTION",
            "reason": "Change-impact reasoning is out of scope for v1."
          }
        },
        {
          "id": "flask-dependency-unsupported",
