# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Release artifacts. Deliberately NOT committed, matching how site/ already
# works: `vercel --prod` uploads the local folder, so these ship without being
# in git. Keeping a 2.3MB binary out of history is the point; the cost is that
# a fresh clone has no DMG until someone copies one in, which is why the build
# check below exists.
/public/Icarus.dmg
/public/icarus-extension.zip

# src/generated/release.json IS committed, deliberately. A CLI deploy uploads
# only web/, so the repo-root manifest is absent on the build machine and the
# build fails without a copy here. scripts/check_release.py asserts the two
# stay identical, so the committed copy cannot drift.
