# Icarus local secrets — COPY this file to `.env` and paste your real keys there.
#   cp .env.example .env      then edit .env
# `.env` is gitignored; this template (no real keys) is the only one committed.
# An inline var on the command line still overrides the file, e.g.:
#   GROQ_API_KEY=... python3 -m demo.server
#
# The brain needs at least ONE writer key to produce answers. Free tiers:
#   Groq   : https://console.groq.com/keys        (default writer)
#   Gemini : https://aistudio.google.com/apikey    (default judge; also a writer)
# OpenRouter is an optional fallback.

GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Billing-enabled Gemini key -- the private-repo writer. Google's paid tier does
# NOT train on inputs/outputs (per the project owner, 2026-07-04) -- see
# docs/plans/2026-07-04-private-repos-per-user-isolation.md for the current
# status of the written policy-link verification. May be the SAME key as
# GEMINI_API_KEY only if that key is genuinely billing-enabled -- placing a
# value here is the operator's attestation that it is.
GEMINI_PAID_API_KEY=

# Where per-user corpora (connected repos, public cache AND private) live.
# Optional -- defaults to <repo>/data if unset.
ICARUS_STORAGE_ROOT=
