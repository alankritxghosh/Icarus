# Icarus local secrets — COPY this file to `.env` and paste your real keys there.
#   cp .env.example .env      then edit .env
# `.env` is gitignored; this template (no real keys) is the only one committed.
# Free writer/judge keys are eval-harness dials, not serving credentials.

GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# The serving writer. A value here attests that this key is billing-enabled and
# therefore permitted by the deterministic trust interlock.
GEMINI_PAID_API_KEY=

# Where per-user public-repo corpora and caches live.
# Optional -- defaults to <repo>/data if unset.
ICARUS_STORAGE_ROOT=

# Product analytics (Mac app + MCP + extension usage -- demo/posthog_capture.py).
# The PRODUCT PostHog project, deliberately separate from the marketing
# website's project/key embedded in site/index.html and demo/index.html.
# Counts and identity only, unless a caller explicitly opts in with
# X-Icarus-Share-Content: 1; unset disables capture entirely (fail-safe no-op).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
