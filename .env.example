# Icarus local secrets — COPY this file to `.env` and paste your real keys there.
#   cp .env.example .env      then edit .env
# `.env` is gitignored; this template (no real keys) is the only one committed.
# Free writer/judge keys are eval-harness dials, not serving credentials.

GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# The serving writer. A value here attests that this key is billing-enabled and
# therefore permitted by the deterministic trust interlock.
GEMINI_PAID_API_KEY=

# Where per-user public-repo corpora and caches live.
# Optional -- defaults to <repo>/data if unset.
ICARUS_STORAGE_ROOT=

# Process-wide launch safety ceilings. These supplement the per-identity limits
# so creating more identities cannot bypass the service's total spend/capacity
# boundary. Keep production values explicit in the deployment configuration.
ICARUS_GLOBAL_ASKS_PER_MINUTE=120
ICARUS_GLOBAL_INVESTIGATIONS_PER_MINUTE=12
ICARUS_GLOBAL_CONNECTS_PER_10_MINUTES=30
ICARUS_MAX_CONCURRENT_WRITERS=8
ICARUS_MAX_CONCURRENT_INGESTS=2

# Product analytics (Mac app + MCP + extension usage -- demo/posthog_capture.py).
# The PRODUCT PostHog project, deliberately separate from the marketing
# website's project/key embedded in site/index.html and demo/index.html.
# Counts and SALTED PSEUDONYMS of the caller and repository -- never their raw
# identifiers -- unless a caller explicitly opts in with
# X-Icarus-Share-Content: 1; unset disables capture entirely (fail-safe no-op).
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Salt for caller and repository pseudonyms in analytics. A private owner/name
# slug is confidential on its own, and an UNSALTED digest of one is reversible
# by hashing a list of repository names. Unset => the repository field is
# omitted and caller events are anonymous rather than weakly hashed. Changing
# it re-keys every caller and repo, so
# past and future events stop grouping together.
ICARUS_ANALYTICS_SALT=
