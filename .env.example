# Icarus local secrets — COPY this file to `.env` and paste your real keys there.
#   cp .env.example .env      then edit .env
# `.env` is gitignored; this template (no real keys) is the only one committed.
# An inline var on the command line still overrides the file, e.g.:
#   GROQ_API_KEY=... python3 -m demo.server
#
# The brain needs at least ONE writer key to produce answers. Free tiers:
#   Groq   : https://console.groq.com/keys        (default writer)
#   Gemini : https://aistudio.google.com/apikey    (default judge; also a writer)
# OpenRouter is an optional fallback.

GROQ_API_KEY=
GEMINI_API_KEY=
# OPENROUTER_API_KEY=
